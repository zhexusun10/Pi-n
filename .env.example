# Optional local configuration. Copy to .env; never commit real credentials.
# Pi^n's primary provider login is via Settings or `npm run pi`.
# Pi can also use supported provider environment variables (e.g. OPENAI_API_KEY).
# OPENAI_API_KEY=replace_with_your_own_key
# Custom OpenAI-compatible providers reference environment keys from models.json in
# the Pi agent dir (~/.pi-n/pi-agent), e.g. "apiKey": "${CLINE_API_KEY}".
# CLINE_API_KEY=replace_with_your_own_key

# Optional role overrides. By default roles follow the model selected in Settings.
# PARTITIONER_MODEL=openai/example-model
# PLANNER_MODEL=openai/example-model
# NODE_AGENT_MODEL=openai/example-model
# MERGER_MODEL=openai/example-model

# Local backend port; frontend dev proxy must use the same value.
# PI_N_PORT=1421
# On macOS, keep the display and system awake while the backend runs so long
# tasks are not interrupted by idle sleep or the screen saver. Set to 0 to
# disable. (No effect on other platforms.)
# PI_N_KEEP_AWAKE=1
# Large caches default to the OS cache (Windows: %LOCALAPPDATA%/Pi-n;
# macOS: ~/Library/Caches/Pi-n; Linux: ${XDG_CACHE_HOME:-~/.cache}/pi-n).
# Runtime records remain in .pi-n (or PI_N_DATA_DIR), separate from caches.
# PI_N_CACHE_DIR=/absolute/path/to/cache
# PI_N_WORKSPACE_PARENT=/absolute/path/to/node-workspaces
# PI_N_NATIVE_RUNTIME_PARENT=/absolute/path/to/shared-engine-cache
# PI_CODING_AGENT_DIR=/absolute/path/to/dedicated/pi-agent
# Global Pi extensions, skills and MCP config (default: ~/.pi/agent).
# PI_N_GLOBAL_PI_AGENT_DIR=/absolute/path/to/global/pi-agent
# Do NOT set PI_N_ALLOWED_ORIGINS unless you understand the local API risk.
