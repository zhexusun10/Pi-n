src-tauri/resources/
desktop-dist/
target*/
.pi-n/
.pi-n-verify*/
.pi-n-path-audit/
.pi/
.agents/skills/

# Python
.venv/
venv/
__pycache__/
*.pyc

# Local Windows launcher scripts
start.bat
scripts/launch.ps1
